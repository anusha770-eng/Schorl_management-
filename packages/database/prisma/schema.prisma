datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model School {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  address     String
  curriculum  String
  createdAt   DateTime @default(now())

  users       User[]
  classes     ClassSection[]
  busRoutes   BusRoute[]
  notices     Notice[]
}

model User {
  id            String    @id @default(cuid())
  schoolId      String
  school        School    @relation(fields: [schoolId], references: [id])
  email         String    @unique
  passwordHash  String
  name          String
  role          String    // ADMIN, PRINCIPAL, TEACHER, STUDENT, PARENT, ACCOUNTANT, TRANSPORT
  phone         String?
  avatarUrl     String?
  languagePref  String    @default("en") // en, hi, kn
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  studentProfile StudentProfile?
  staffProfile   StaffProfile?
  parentProfile  ParentProfile?
  auditLogs      AuditLog[]
}

model StudentProfile {
  id                  String         @id @default(cuid())
  userId              String         @unique
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  admissionNumber     String         @unique
  rollNumber          String
  dateOfBirth         DateTime
  gender              String
  bloodGroup          String?
  classSectionId      String
  classSection        ClassSection   @relation(fields: [classSectionId], references: [id])
  guardianId          String?
  guardian            ParentProfile? @relation(fields: [guardianId], references: [id])
  busRouteId          String?
  busRoute            BusRoute?      @relation(fields: [busRouteId], references: [id])
  busStopId           String?
  busStop             BusStop?       @relation(fields: [busStopId], references: [id])
  
  // Holistic Growth Index (HGI: 0-100)
  holisticGrowthIndex Float          @default(88.0)
  
  attendanceRecords   AttendanceRecord[]
  grades              GradeRecord[]
  mtssFlags           MTSSFlag[]
  socraticSessions    SocraticSession[]
  feeInvoices         FeeInvoice[]
  busBoardingLogs     BusAttendance[]
  selMoodLogs         SELMoodLog[]
}

model StaffProfile {
  id              String         @id @default(cuid())
  userId          String         @unique
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode    String         @unique
  designation     String
  department      String
  specializations String         // JSON array string of specializations
  maxWeeklyHours  Int            @default(30)
  currentHours    Int            @default(0)
  
  timetables      TimetableSlot[]
  substitutions   SubstitutionRecord[]
  mtssActions     MTSSIntervention[]
}

model ParentProfile {
  id              String           @id @default(cuid())
  userId          String           @unique
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  occupation      String?
  students        StudentProfile[]
}

model ClassSection {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])
  gradeLevel  Int
  sectionName String
  roomNumber  String
  academicYear String

  students    StudentProfile[]
  timetable   TimetableSlot[]
  attendance  AttendanceRecord[]
  exams       Exam[]
}

model TimetableSlot {
  id             String       @id @default(cuid())
  classSectionId String
  classSection   ClassSection @relation(fields: [classSectionId], references: [id])
  staffId        String
  staff          StaffProfile @relation(fields: [staffId], references: [id])
  subject        String
  dayOfWeek      Int          // 1 = Monday ... 5 = Friday
  periodNumber   Int          // 1 .. 8
  startTime      String       // "08:30"
  endTime        String       // "09:15"
}

model AttendanceRecord {
  id             String           @id @default(cuid())
  date           String           // YYYY-MM-DD
  classSectionId String
  classSection   ClassSection     @relation(fields: [classSectionId], references: [id])
  studentId      String
  student        StudentProfile   @relation(fields: [studentId], references: [id])
  periodNumber   Int?             // null for full day, 1-8 for specific period
  status         String           // PRESENT, ABSENT, LATE, EXCUSED
  markedById     String
  remarks        String?
  createdAt      DateTime         @default(now())
}

model Exam {
  id             String       @id @default(cuid())
  classSectionId String
  classSection   ClassSection @relation(fields: [classSectionId], references: [id])
  title          String
  subject        String
  maxMarks       Float        @default(100)
  date           DateTime
  term           String

  grades         GradeRecord[]
}

model GradeRecord {
  id             String         @id @default(cuid())
  examId         String
  exam           Exam           @relation(fields: [examId], references: [id])
  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id])
  marksObtained  Float
  letterGrade    String?
  teacherRemarks String?
  aiRemarkDraft  String?
  createdAt      DateTime       @default(now())
}

// ── Signature Innovation Entities ──

model MTSSFlag {
  id                String         @id @default(cuid())
  studentId         String
  student           StudentProfile @relation(fields: [studentId], references: [id])
  severity          String         // TIER_1_LOW, TIER_2_MODERATE, TIER_3_CRITICAL
  domain            String         // ACADEMIC, ATTENDANCE, SEL
  triggerReason     String
  status            String         // ACTIVE, IN_INTERVENTION, RESOLVED
  recommendedAction String
  encryptedNotes    String?        // Encrypted sensitive clinical / counseling notes
  createdAt         DateTime       @default(now())

  interventions     MTSSIntervention[]
}

model MTSSIntervention {
  id                String       @id @default(cuid())
  flagId            String
  flag              MTSSFlag     @relation(fields: [flagId], references: [id])
  assignedToStaffId String
  staff             StaffProfile @relation(fields: [assignedToStaffId], references: [id])
  strategy          String
  progressNotes     String?
  outcomeStatus     String       @default("IN_PROGRESS") // IN_PROGRESS, IMPROVING, RESOLVED
  updatedAt         DateTime     @updatedAt
}

model SocraticSession {
  id             String         @id @default(cuid())
  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id])
  subject        String
  topic          String
  curriculumRef  String?        // Reference to chapter / standard (e.g., "Math-G9-Ch4")
  messages       String         // JSON serialized conversation [{ role, content, timestamp }]
  masteryScore   Float?
  conceptGaps    String?        // JSON serialized array of strings
  createdAt      DateTime       @default(now())
}

model CurriculumUnit {
  id          String   @id @default(cuid())
  subject     String
  gradeLevel  Int
  chapter     Int
  title       String
  summary     String
  keyConcepts String   // JSON array of core concepts
  contentBody String   // Textual chapter knowledge base for Socratic grounding
}

model SubstitutionRecord {
  id                String       @id @default(cuid())
  date              String       // YYYY-MM-DD
  slotId            String
  originalStaffId   String
  substituteStaffId String
  substituteStaff   StaffProfile @relation(fields: [substituteStaffId], references: [id])
  status            String       // AUTO_RECOMMENDED, CONFIRMED, COMPLETED
  matchingScore     Float
  createdAt         DateTime     @default(now())
}

model BusRoute {
  id             String           @id @default(cuid())
  schoolId       String
  school         School           @relation(fields: [schoolId], references: [id])
  routeNumber    String
  driverName     String
  driverPhone    String
  attendantName  String
  vehicleNumber  String
  currentLat     Float?
  currentLng     Float?
  lastPing       DateTime?
  status         String           @default("IDLE") // IDLE, IN_TRANSIT, COMPLETED

  stops          BusStop[]
  students       StudentProfile[]
  boardingLogs   BusAttendance[]
}

model BusStop {
  id             String           @id @default(cuid())
  routeId        String
  route          BusRoute         @relation(fields: [routeId], references: [id])
  stopName       String
  sequenceOrder  Int
  scheduledTime  String
  lat            Float
  lng            Float
  students       StudentProfile[]
}

model BusAttendance {
  id             String         @id @default(cuid())
  date           String         // YYYY-MM-DD
  busRouteId     String
  busRoute       BusRoute       @relation(fields: [busRouteId], references: [id])
  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id])
  tripType       String         // MORNING_PICKUP, AFTERNOON_DROPOFF
  boardedAt      DateTime       @default(now())
  verifiedBy     String         // ATTENDANT_SCAN, MANUAL_TAP
}

model FeeInvoice {
  id             String         @id @default(cuid())
  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id])
  invoiceNumber  String         @unique
  totalAmount    Float
  paidAmount     Float          @default(0.0)
  dueDate        DateTime
  status         String         // PENDING, PARTIAL, PAID, OVERDUE, INSTALLMENT_REQUESTED
  breakdown      String         // JSON array of fee heads
  installmentNote String?
  createdAt      DateTime       @default(now())
}

model SELMoodLog {
  id             String         @id @default(cuid())
  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id])
  date           String         // YYYY-MM-DD
  moodScore      Int            // 1 to 5
  energyLevel    Int            // 1 to 3
  note           String?
  createdAt      DateTime       @default(now())
}

model Notice {
  id             String         @id @default(cuid())
  schoolId       String
  school         School         @relation(fields: [schoolId], references: [id])
  title          String
  content        String
  translations   String         // JSON serialized { en, hi, kn }
  category       String         // CRITICAL, ACADEMIC, GENERAL
  targetRole     String?
  targetGrade    Int?
  authorName     String
  publishedAt    DateTime       @default(now())
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  action      String   // SENSITIVE_RECORD_READ, GRADE_MODIFIED, etc.
  entityType  String
  entityId    String
  metadata    String?
  ipAddress   String?
  timestamp   DateTime @default(now())
}
